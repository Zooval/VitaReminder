<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TreatmentsActivity">

    <TextView
        android:id="@+id/tvEditarTratamiento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="Editar Tratamiento"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTratamientosTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Tratamientos"
        android:textColor="@color/colorPrimary"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/tvEditarTratamiento"
        app:layout_constraintTop_toBottomOf="@+id/tvEditarTratamiento" />

    <TextView
        android:id="@+id/tvSeleccionaTratamiento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Selecciona el tratamiento:"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@+id/tvTratamientosTitle"
        app:layout_constraintTop_toBottomOf="@+id/tvTratamientosTitle" />

    <!-- En una app real, esto sería un RecyclerView -->
    <!-- En una app real, esto sería un RecyclerView -->
    <LinearLayout
        android:id="@+id/treatmentsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvSeleccionaTratamiento"
        app:layout_constraintStart_toStartOf="@+id/tvSeleccionaTratamiento"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Fila de Tratamiento #1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnTratamiento1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@color/colorPrimary"
                android:text="Tratamiento#1" />

            <ImageButton
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/trash"
                android:backgroundTint="@color/colorPrimary"
                app:tint="@android:color/white"
                android:contentDescription="Eliminar" />
        </LinearLayout>

        <!-- Fila de Tratamiento #2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@color/colorPrimary"
                android:text="Tratamiento#1" />

            <ImageButton
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/trash"
                android:backgroundTint="@color/colorPrimary"
                app:tint="@android:color/white"
                android:contentDescription="Eliminar" />
        </LinearLayout>

        <!-- Fila de Tratamiento #3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@color/colorPrimary"
                android:text="Tratamiento#1" />

            <ImageButton
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/trash"
                android:backgroundTint="@color/colorPrimary"
                app:tint="@android:color/white"
                android:contentDescription="Eliminar" />
        </LinearLayout>

    </LinearLayout>


    <Button
        android:id="@+id/btnVolver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Volver"
        android:layout_marginBottom="32dp"
        android:backgroundTint="@color/colorPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
